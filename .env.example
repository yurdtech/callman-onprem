# ═════════════════════════════════════════════════════════════════════
# Callman on-prem — configuration.
#
# 1. Copy this file:        cp .env.example .env
# 2. Fill in every value marked <CHANGE_ME>.
# 3. Generate each secret:  openssl rand -hex 32
# 4. Check your work:       ./scripts/preflight.sh
#
# This file is the ONLY thing you edit. Never edit docker-compose.yml —
# everything, including using your own databases, is configured here.
#
# Never commit your real `.env`. This template contains placeholders only.
# Full reference: docs/ENVIRONMENT.md
# ═════════════════════════════════════════════════════════════════════

# ─── Version ─────────────────────────────────────────────────────────
# Which release to run. We tell you the version to use, e.g. 1.0.1.
CALLMAN_VERSION=<CHANGE_ME_VERSION>

# Edition marker — keep as "onprem".
CALLMAN_EDITION=onprem

# Runtime mode — keep as "production".
NODE_ENV=production

# ─── Network ─────────────────────────────────────────────────────────
# The single port the API listens on AND is published on. Browse / curl
# the backend at http://<this-host>:<CALLMAN_PORT>.
CALLMAN_PORT=8080

# ═════════════════════════════════════════════════════════════════════
# DATABASES — bundled (default) or your own
#
# COMPOSE_PROFILES decides which databases this stack RUNS for you.
# Whatever you leave enabled here, you never touch docker-compose.yml.
#
#   bundled-mongo  → we run MongoDB for you (data in a Docker volume)
#   bundled-redis  → we run Redis for you
#
# To use YOUR OWN database, remove its profile from the line below and
# set the matching connection URI further down. You can mix freely, e.g.
# your company MongoDB with our bundled Redis.
#
# Full guide (auth, replica sets, TLS/private CA, a DB on this host):
# docs/EXTERNAL-DATABASES.md
# ═════════════════════════════════════════════════════════════════════
# Add "ui-runner" to also run the UI-test runner (scheduled web UI tests in
# a headless browser). Opt-in: the image is ~2 GB and each replica needs
# ~2 GB RAM. Example: COMPOSE_PROFILES=bundled-mongo,bundled-redis,ui-runner
COMPOSE_PROFILES=bundled-mongo,bundled-redis

# ─── UI-test runner — only used when "ui-runner" is above ────────────
# Browsers per runner replica (1–5). Parallel web tests = replicas × this.
UITEST_WORKER_CONCURRENCY=2
# Per-run time limit in ms (default 15 minutes).
UITEST_RUN_MAX_DURATION_MS=900000

# ─── Bundled MongoDB — only used when "bundled-mongo" is above ───────
# Credentials for the bundled MongoDB container. Pick your own — the app's
# connection string is built from these automatically.
#
# ⚠ These apply ONLY when the data volume is first created. Changing them
#   later does NOT change the existing database user; see
#   docs/TROUBLESHOOTING.md.
MONGO_ROOT_USERNAME=callman
MONGO_ROOT_PASSWORD=<CHANGE_ME_MONGO_PASSWORD>

# ─── Bundled Redis — only used when "bundled-redis" is above ─────────
# Password for the bundled Redis container (also used by the app).
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# ─── YOUR OWN databases (leave commented for the default install) ────
# Set these ONLY for a database you run yourself, and remove the matching
# profile from COMPOSE_PROFILES above. Your value always wins.
#
# ⚠ Uncomment each of these AT MOST ONCE. If a variable is defined twice,
#   only the last definition is used — a common way to end up connected to
#   the wrong database.
#
# Your Redis MUST run with `maxmemory-policy noeviction` — background jobs
# live in Redis and must never be evicted.

# MONGODB_URI=mongodb://user:pass@mongo.acme.local:27017/callman?authSource=admin
# REDIS_URL=redis://:pass@redis.acme.local:6379

# Adjust the URI above for your setup — do NOT add a second MONGODB_URI line:
#
#   Database on THIS machine but outside Docker? Inside a container
#   "localhost" is the container itself, so use host.docker.internal:
#     ...@host.docker.internal:27017/callman?authSource=admin
#
#   Replica set? List every member and name the set:
#     ...@m1:27017,m2:27017,m3:27017/callman?authSource=admin&replicaSet=rs0
#
#   TLS with a private/internal CA? Drop the PEM into ./certs/ (mounted
#   read-only at /certs in every container) and append:
#     &tls=true&tlsCAFile=/certs/mongo-ca.pem
#
#   Special characters in the password must be percent-encoded:
#     p@ss/w0rd  →  p%40ss%2Fw0rd
#
# Full guide: docs/EXTERNAL-DATABASES.md

# ─── JWT / auth secrets (REQUIRED, must be DIFFERENT from each other) ─
# Each ≥ 32 chars. Generate four DISTINCT values:  openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_RUN_openssl_rand_hex_32>
JWT_REFRESH_SECRET=<CHANGE_ME_RUN_openssl_rand_hex_32>

# Token lifetimes (optional — sensible defaults shown).
# JWT_EXPIRES_IN=1h
# JWT_REFRESH_EXPIRES_IN=30d

# ─── Encryption secrets (REQUIRED, must be DIFFERENT) ────────────────
# Encrypt stored sessions + saved DB/connection credentials. ≥ 32 chars.
SESSION_TOKEN_ENCRYPTION_SECRET=<CHANGE_ME_RUN_openssl_rand_hex_32>

# ⚠ SHARED KEY — the backend AND the admin panel both read this one value.
#   The admin panel encrypts AI provider keys with it and the backend
#   decrypts them. They must stay identical. If you ever rotate it, saved
#   connection credentials and AI keys become unreadable and must be
#   re-entered.
CONNECTION_ENCRYPTION_KEY=<CHANGE_ME_RUN_openssl_rand_hex_32>

# All four secrets above MUST be four DIFFERENT values, or the app refuses
# to start.

# ─── Login methods — NOT configured here ─────────────────────────────
# Which login methods Callman offers (email + password, and/or your
# corporate LDAP / Active Directory) is configured in the ADMIN PANEL:
#
#   http://<this-host>:<CALLMAN_ADMIN_PORT>  →  On-Prem → Authentication
#
# Set it there and it applies within about 30 seconds — no .env edit, no
# restart, and you can test the directory connection before saving.
# Guide: docs/AUTH_SETUP.md
#
# (This applies to the Callman app. The admin panel itself always uses its
# own separate email + password login, configured below.)

# ─── Worker / BullMQ (optional) ──────────────────────────────────────
# Background scenario-run engine. Defaults are fine for most installs.
# BULLMQ_WORKER_CONCURRENCY=50
# PM2_INSTANCES=1
# Port the worker serves its own health probes on, inside the container.
# Not published to the host; change only on a port conflict.
# WORKER_HEALTH_PORT=9090

# ─── Bull Board queue dashboard (optional) ───────────────────────────
# Set BOTH to enable the /admin/queues dashboard (off when unset).
# BULL_BOARD_USERNAME=<CHANGE_ME>
# BULL_BOARD_PASSWORD=<CHANGE_ME>

# ─── Observability (optional) ────────────────────────────────────────
# Prometheus /metrics endpoint. Leave on; set false to disable.
# METRICS_ENABLED=true

# Error reporter → Telegram. This forwards desktop crash reports to a
# Telegram channel run by the vendor. On-prem installs normally DISABLE it
# (no outbound internet needed). To DISABLE, leave the value EMPTY as below
# (an empty value = off). To ENABLE, set it to a value AND provide both
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
# ⚠ Setting it to the text "false" does NOT disable it — only an empty
#   value does.
TELEGRAM_ENABLED=

# ─── CORS (optional) ─────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Leave blank for
# desktop-app-only installs.
# CLIENT_ORIGIN=

# Public URLs (optional) — set to your real external URL if you expose the
# API publicly, so generated links/mock URLs are correct.
# PUBLIC_API_BASE_URL=https://callman.example.com
# MOCK_PUBLIC_BASE_URL=https://callman.example.com

# ─── Migration backup (optional) ─────────────────────────────────────
# Where the automatic pre-migration mongodump is written (a Docker volume
# is mounted here by default — leave as-is). See docs/BACKUP.md.
# MONGODB_BACKUP_DIR=/backups

# ─── Admin panel ─────────────────────────────────────────────────────
# Web admin panel (separate image, separate version from the backend).
# It connects to the SAME MongoDB as the backend — bundled or your own,
# it follows MONGODB_URI automatically. You do NOT configure a separate
# database for it.

# Required: which admin image tag to run (e.g. 0.1.0). We tell you which.
CALLMAN_ADMIN_VERSION=<CHANGE_ME_ADMIN_VERSION>

# Port to reach the admin panel on (UI + API, same origin).
CALLMAN_ADMIN_PORT=5100

# Required: admin auth secrets — SEPARATE from the backend secrets above,
# and ≥ 32 chars each. Generate with:  openssl rand -hex 32
ADMIN_JWT_SECRET=<CHANGE_ME_RUN_openssl_rand_hex_32>
ADMIN_JWT_REFRESH_SECRET=<CHANGE_ME_RUN_openssl_rand_hex_32>

# Backend API base URL for the admin panel's managed-connections "Test"
# action — the real DB/Kafka/Redis driver tests run in the backend, and the
# connection config travels ENCRYPTED with CONNECTION_ENCRYPTION_KEY (never
# in plaintext). docker-compose.yml already defaults this to the bundled
# backend (http://backend:<CALLMAN_PORT>); set it ONLY when the backend runs
# outside this compose file.
# CALLMAN_BACKEND_API_URL=http://backend:8080

# First admin user, seeded on first start if the admin_users collection is
# empty. ⚠ Use a STRONG password and change it right after first login.
ADMIN_BOOTSTRAP_EMAIL=<CHANGE_ME_admin@example.com>
ADMIN_BOOTSTRAP_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Optional admin tunables (safe defaults shown):
# ADMIN_JWT_EXPIRES_IN=1h
# ADMIN_JWT_REFRESH_EXPIRES_IN=7d
# ADMIN_BCRYPT_ROUNDS=12
# ADMIN_BOOTSTRAP_* can be removed after the first admin exists.
# CORS_ORIGINS=                      # comma-separated; only for cross-origin UIs
# RATE_LIMIT_MAX=300
# Keep false so the admin panel can READ but never MODIFY core Callman data:
# CALLMAN_DB_WRITE_ENABLED=false
# Only if the admin panel must use a DIFFERENT Mongo than the backend
# (unusual — by default it follows MONGODB_URI):
# CALLMAN_MONGODB_URI=
