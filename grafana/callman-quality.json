{
  "__inputs": [
    {
      "name": "DS_CALLMAN",
      "label": "Callman Public API",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "2.0.0"
    }
  ],
  "uid": "callman-quality",
  "title": "Callman — test runs and inventory",
  "description": "Runs, pass rate, failing and flaky tests, the test inventory — Callman Public API (runs:read, tests:read). See callman-onprem docs/GRAFANA.md.",
  "tags": [
    "callman",
    "qa",
    "runs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tribe",
        "label": "Tribe",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "variable",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "${datasource}"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/api/public/v1/org/groups",
            "url_options": {
              "method": "GET",
              "data": "",
              "params": [
                {
                  "key": "level",
                  "value": "tribe"
                }
              ]
            },
            "root_selector": "data.rows",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ],
            "filters": [],
            "computed_columns": []
          }
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "$__all",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs in range",
      "description": "Scenario, UI test and pipeline runs started in the dashboard's time range (load tests and desktop runs not counted).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/runs/stats",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "interval",
                "value": "day"
              },
              {
                "key": "by",
                "value": "org"
              },
              {
                "key": "groupId",
                "value": "${tribe:csv}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "root_selector": "data.rows",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "runs",
              "text": "Runs",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": "/^Runs$/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
