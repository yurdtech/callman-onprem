            {
              "selector": "dau",
              "text": "DAU",
              "type": "number"
            },
            {
              "selector": "wau",
              "text": "WAU",
              "type": "number"
            },
            {
              "selector": "mau",
              "text": "MAU",
              "type": "number"
            },
            {
              "selector": "totalUsers",
              "text": "People",
              "type": "number"
            },
            {
              "selector": "activePct",
              "text": "Active %",
              "type": "number"
            },
            {
              "selector": "stickinessPct",
              "text": "Stickiness %",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Tribe": 0,
              "DAU": 1,
              "WAU": 2,
              "MAU": 3,
              "People": 4,
              "Active %": 5,
              "Stickiness %": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      }
    },
