{
  "__inputs": [
    {
      "name": "DS_CALLMAN",
      "label": "Callman Public API",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "2.0.0"
    }
  ],
  "uid": "callman-usage",
  "title": "Callman — usage and licence",
  "description": "Licence seats and expiry, active people, desktop versions, feature adoption — Callman Public API (usage:read, organization-wide token for the licence). See callman-onprem docs/GRAFANA.md.",
  "tags": [
    "callman",
    "usage"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tribe",
        "label": "Tribe",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "variable",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "${datasource}"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/api/public/v1/org/groups",
            "url_options": {
              "method": "GET",
              "data": "",
              "params": [
                {
                  "key": "level",
                  "value": "tribe"
                }
              ]
            },
            "root_selector": "data.rows",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ],
            "filters": [],
            "computed_columns": []
          }
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "$__all",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Licence",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Seats used",
      "description": "Callman accounts — one account is one seat. Needs an organization-wide token.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/usage/licence",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": []
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "seatsUsed",
              "text": "Seats used",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Seats used %",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/usage/licence",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": []
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "seatsUsedPct",
              "text": "Seats used %",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Licence days left",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/usage/licence",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": []
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "daysLeft",
              "text": "Days left",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Licence health",
      "description": "valid / expiring / over_seats / expired / unlicensed.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/usage/licence",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": []
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "health",
              "text": "Health",
              "type": "string"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Health$/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "valid": {
                  "color": "green",
                  "index": 0
                },
                "expiring": {
                  "color": "orange",
                  "index": 1
                },
                "over_seats": {
                  "color": "red",
                  "index": 2
                },
                "expired": {
                  "color": "red",
                  "index": 3
                },
                "unlicensed": {
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Active people",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active people per day",
      "description": "Sent a request, started a run by hand or changed something that day (scheduled / CI runs do not count). Range up to 366 days.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/usage/active-users",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "interval",
                "value": "day"
              },
              {
                "key": "by",
                "value": "org"
              },
              {
                "key": "groupId",
                "value": "${tribe:csv}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "root_selector": "data.rows",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "activeUsers",
              "text": "Active",
              "type": "number"
            },
            {
              "selector": "totalUsers",
              "text": "Accounts",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "DAU / WAU / MAU per tribe",
      "description": "Active in the last 1 / 7 / 30 days; stickiness = DAU ÷ MAU.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/usage/active-users",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "shape",
                "value": "summary"
              },
              {
                "key": "by",
                "value": "tribe"
              },
              {
                "key": "groupId",
                "value": "${tribe:csv}"
