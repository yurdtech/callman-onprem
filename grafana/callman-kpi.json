{
  "__inputs": [
    {
      "name": "DS_CALLMAN",
      "label": "Callman Public API",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "2.0.0"
    }
  ],
  "uid": "callman-kpi",
  "title": "Callman \u2014 QA KPIs",
  "description": "Team KPIs from the Callman Public API: the bank's five Grafana panels, running tests today, people. See callman-onprem docs/GRAFANA.md.",
  "tags": [
    "callman",
    "kpi",
    "qa"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tribe",
        "label": "Tribe",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "variable",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "${datasource}"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/api/public/v1/org/groups",
            "url_options": {
              "method": "GET",
              "data": "",
              "params": [
                {
                  "key": "level",
                  "value": "tribe"
                }
              ]
            },
            "root_selector": "data.rows",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ],
            "filters": [],
            "computed_columns": []
          }
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "$__all",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "squad",
        "label": "Squad",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "variable",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "${datasource}"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/api/public/v1/org/groups",
            "url_options": {
              "method": "GET",
              "data": "",
              "params": [
                {
                  "key": "level",
                  "value": "squad"
                },
                {
                  "key": "parentId",
                  "value": "${tribe:csv}"
                }
              ]
            },
            "root_selector": "data.rows",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ],
            "filters": [],
            "computed_columns": []
          }
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "$__all",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Organization",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "KPI data refreshed",
      "description": "When the Callman KPI engine last refreshed. Stale = older than twice the refresh interval.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/kpi/status",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": []
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "lastRefreshAt",
              "text": "Last refresh",
              "type": "timestamp"
            },
            {
              "selector": "stale",
              "text": "Stale",
              "type": "boolean"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/Last refresh/"
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Organization \u2014 this week",
      "description": "Every team KPI for the whole organization, current week. Needs an organization-wide token.",
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/kpi/results",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "periodType",
                "value": "week"
              },
              {
                "key": "level",
                "value": "org"
              },
              {
                "key": "frozen",
                "value": "false"
              }
            ]
          },
          "root_selector": "data.rows",
          "columns": [
            {
              "selector": "kpi",
              "text": "KPI",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "Value",
              "type": "number"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "displayName": "${__data.fields.KPI}"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Regression automation coverage (quarter)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Squads \u2014 Test Automation Scenario counts",
      "description": "Valid regression tests \u00f7 (regression \u2212 can't automate \u2212 no need to automate), this quarter, per squad.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/public/v1/kpi/results",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "periodType",
                "value": "quarter"
              },
              {
                "key": "kpiId",
                "value": "regression_automation_coverage"
              },
              {
                "key": "level",
                "value": "squad"
              },
              {
                "key": "frozen",
                "value": "false"
              },
              {
                "key": "groupId",
                "value": "${squad:csv}"
              }
            ]
          },
          "root_selector": "data.rows",
          "columns": [
            {
              "selector": "groupPath",
              "text": "Group",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "Coverage %",
              "type": "number"
            },
            {
              "selector": "targetMin",
              "text": "Minimum",
              "type": "number"
            },
            {
              "selector": "target",
              "text": "Target",
              "type": "number"
            },
            {
              "selector": "status",
              "text": "Status",
              "type": "string"
            }
          ],
          "filters": [],
          "computed_columns": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Group": 0,
              "Coverage %": 1,
              "Minimum": 2,
              "Target": 3,
              "Status": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Coverage %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "lcd"
                }
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "green",
                      "value": 80
                    }
                  ]
                }
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
